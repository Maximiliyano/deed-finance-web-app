{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "DatabaseConnection": "",
  "BankSettings": {
    "ExchangeRates": "https://api.privatbank.ua/p24api/exchange_rates?json&date={0}",
    "PersonalClientInfo": "https://api.monobank.ua/personal/client-info",
    "ApiKey": ""
  },
  "PrivatAutoclientSettings": {
    "BaseUrl": "https://acp.privatbank.ua/api",
    "TransactionsPath": "statements/transactions"
  },
  "WebUrlSettings": {
    "UIUrl": "",
    "AllowedHeaders": [
      "Content-Type",
      "Authorization"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ]
  },
  "AuthSettings": {
    "Domain": "",
    "ClientId": "",
    "ClientSecret": "",
    "Audience": ""
  },
  "BackgroundJobsSettings": {
    "CronExchangeSchedule": "0 0 9 * * ?",
    "CronReminderCheckSchedule": "0 0/15 * * * ?",
    "CronBankSyncSchedule": "0 0/5 * * * ?",
    "CronBankAccountRefreshSchedule": "0 0 5 * * ?"
  },
  "DataProtectionSettings": {
    "CertificateBase64": "",
    "CertificatePassword": "",
    "ReprotectExistingKeys": false
  },
  "SmtpSettings": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": ""
  },
  "MemoryCacheSettings": {
    "ExchangesTimespanInHours": 12,
    "CategoriesTimespanInHours": 1 
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
